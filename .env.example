# Firebase Authentication (client configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase (public client configuration protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers
# BYOK credentials are configured in the Connections UI, encrypted, and never public.
GEMINI_MODEL=gemini-3.6-flash

# PayU Test Mode (server-only; never prefix these with NEXT_PUBLIC_)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_PRO_MONTHLY_AMOUNT=999.00
PAYU_TEST_CUSTOMER_PHONE=9999999999

# Application
# Public origin used by PayU callbacks, for example https://example.com.
APP_URL=http://localhost:3000
# Server-only 32-byte base64 key used to encrypt connected credentials.
# Generate with: openssl rand -base64 32
CONNECTIONS_ENCRYPTION_KEY=
